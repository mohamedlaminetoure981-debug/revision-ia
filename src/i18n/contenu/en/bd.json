        "text": "Hamdallaye"
       },
       {
        "text": "Madina"
       },
       {
        "text": "Matam"
       },
       {
        "text": "Taouyah"
       },
       {
        "text": "Dixinn"
       },
       {
        "text": "Bonfi"
       },
       {
        "text": "Kaloum"
       },
       {
        "text": "16/09"
       },
       {
        "text": "01/10"
       },
       {
        "text": "06/10"
       }
      ]
     },
     {
      "bubbles": [
       {
        "text": "A month of attacks. Nobody noticed a thing. Except me."
       }
      ]
     },
     {
      "bubbles": [
       {
        "text": "Why are you showing me this?"
