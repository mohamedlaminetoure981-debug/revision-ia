   },
   {
    "panels": [
     {
      "bg": {
       "lines": "#8b5cf6"
      },
      "bubbles": [
       {
        "text": "He… doesn't remember?"
       }
      ]
     },
     {
      "bg": {
       "text": "No results.",
       "from": "Search: \"Madina attack\""
