    ]
   },
   {
    "panels": [
     {
      "captions": [
       {
        "text": "That evening. Kaloum, on Mory's roof."
       }
      ]
     },
     {
      "bubbles": [
       {
        "text": "Two bars of signal. Forty seconds to load."
       },
       {
        "text": "How do you cope?"
       },
       {
        "text": "Mental training."
       }
      ]
     },
     {
      "bubbles": [
