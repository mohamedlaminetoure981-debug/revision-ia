 "ch02": {
  "title": "The Signal",
  "pages": [
   {
    "panels": [
     {
      "captions": [
       {
        "text": "The next day. University of Conakry."
       }
      ]
     },
     {
      "bubbles": [
       {
        "text": "Today: graphs. Vertices… and edges."
       }
      ]
